# Copy to .env (never commit .env). One file serves both the CLI and the Next.js server.

# --- Required -------------------------------------------------------------
# "testnet" (recommended) or "mainnet".
HEDERA_NETWORK=testnet
# Your funded operator account from https://portal.hedera.com (0.0.x).
HEDERA_OPERATOR_ID=
# Its private key: DER (starts 302e / 3030) or 0x-prefixed ECDSA hex.
HEDERA_OPERATOR_KEY=

# --- Optional -------------------------------------------------------------
# Only needed for a raw hex key without 0x: "ecdsa" or "ed25519".
HEDERA_OPERATOR_KEY_TYPE=
# HBAR the operator gives each new passport account (agent + peer). Default 5.
AGENT_INITIAL_BALANCE_HBAR=
# Display name, bio and model written into the agent's HCS-11 profile.
AGENT_NAME=
AGENT_DESCRIPTION=
AGENT_MODEL=
# Join an existing HCS-10 registry topic instead of creating your own.
HCS10_REGISTRY_TOPIC_ID=
# Alternative Mirror Node base URL (no trailing /api/v1).
MIRROR_NODE_URL=
# Where agent keys and topic IDs are stored. Default: .passport/state.json
PASSPORT_STATE_FILE=
